PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Firebase Admin para Render. Opcion 1: service account completo en base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opcion 2: variables sueltas. Reemplaza \n en la private key si Render la guarda escapada.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
